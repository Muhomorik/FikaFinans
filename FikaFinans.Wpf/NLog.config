<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <targets>
    <!-- Debugger target - writes to Visual Studio Debug Output window -->
    <target xsi:type="Debugger"
            name="debugger"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}" />

    <!-- Console target - writes to console -->
    <target xsi:type="Console"
            name="console"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}" />

    <!-- Pipeline file - the signal-driven steps 1-2 and what feeds them. Wiped on every app
         start, so each run reads on its own. Lands next to the exe, in logs\pipeline.log. -->
    <target xsi:type="File"
            name="pipeline"
            fileName="${basedir}/logs/pipeline.log"
            deleteOldFileOnStartup="true"
            keepFileOpen="true"
            encoding="utf-8"
            layout="${longdate}|${level:uppercase=true}|${threadid}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}" />
  </targets>

  <rules>
    <!-- Write all logs to debugger and console -->
    <logger name="*" minlevel="Trace" writeTo="debugger,console" />

    <!-- Pipeline file, full detail. "final" stops the catch-all below from writing the same
         line twice. -->
    <!-- NAV detection and the signal that enters the pipeline -->
    <logger name="NavChangeDetector" minlevel="Trace" writeTo="pipeline" final="true" />
    <logger name="LocalRxNavSignalBus" minlevel="Trace" writeTo="pipeline" final="true" />
    <logger name="FikaFinans.Wpf.ViewModels.NavSyncViewModel" minlevel="Trace" writeTo="pipeline" final="true" />
    <logger name="FikaFinans.Wpf.ViewModels.MainWindowViewModel" minlevel="Trace" writeTo="pipeline" final="true" />
    <!-- Step 1 and step 2: entry points, handlers (Step01DataLoaderHandler,
         Step02MetricsCalculatorHandler, Step02MetricsCalculatorEntry), config -->
    <logger name="PipelineFrontDoor" minlevel="Trace" writeTo="pipeline" final="true" />
    <logger name="Step0*" minlevel="Trace" writeTo="pipeline" final="true" />
    <logger name="JsonBackedStep02MetricsConfigProvider" minlevel="Trace" writeTo="pipeline" final="true" />
    <!-- The per-ISIN row and the buses between the steps -->
    <logger name="RepositoryBackedIsinProgressStore" minlevel="Trace" writeTo="pipeline" final="true" />
    <logger name="LocalRxPipelineSignalBus" minlevel="Trace" writeTo="pipeline" final="true" />
    <logger name="LocalRxStepEventBus" minlevel="Trace" writeTo="pipeline" final="true" />
    <!-- The two tabs, including orphaned-run recovery on first open -->
    <logger name="FikaFinans.Wpf.ViewModels.Steps.Step1DataLoaderViewModel" minlevel="Trace" writeTo="pipeline" final="true" />
    <logger name="FikaFinans.Wpf.ViewModels.Steps.Step2MetricsCalculatorViewModel" minlevel="Trace" writeTo="pipeline" final="true" />

    <!-- Everything else: warnings and errors only, so a failure elsewhere still shows up. -->
    <logger name="*" minlevel="Warn" writeTo="pipeline" />
  </rules>
</nlog>
